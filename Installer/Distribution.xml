<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>MAC-LIMPO</title>
    <organization>com.alexkads</organization>

    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <!-- customize="never": o pacote tem um único componente. Deixar algo
         desmarcável só criaria caminhos de instalação parciais para testar. -->
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>

    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>

    <choices-outline>
        <line choice="default"/>
    </choices-outline>

    <choice id="default" title="MAC-LIMPO">
        <pkg-ref id="com.alexkads.MAC-LIMPO.pkg"/>
    </choice>

    <pkg-ref id="com.alexkads.MAC-LIMPO.pkg" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
